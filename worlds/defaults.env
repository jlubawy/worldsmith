# Gameplay defaults for every world. Your own details (server name,
# allowlist, time zone) come from config.env, written by `./mc setup`.
# Override anything per world in worlds/<world>.env; apply with ./mc restart.
# Full option list: https://docker-minecraft-server.readthedocs.io/en/latest/variables/bedrock/

GAMEMODE=survival
DIFFICULTY=easy
ALLOW_CHEATS=false
MAX_PLAYERS=10
VIEW_DISTANCE=32

# Off at home: no Xbox sign-in needed on the LAN. compose.cloud.yaml forces
# it on (plus the allowlist) when the server runs in the cloud.
ONLINE_MODE=false
WHITE_LIST=false
DEFAULT_PLAYER_PERMISSION_LEVEL=member

# LATEST, PREVIEW, or a pin like 1.26.51.1
VERSION=LATEST

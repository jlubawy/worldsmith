# Machine-specific. Not synced between home and cloud.
# The active world. Change it with `./mc use <world>`, not by hand.
WORLD=world

# The address players reach this server at; advertised for gameplay traffic.
PUBLIC_IP=192.168.1.50

# Cloud server only (`./mc cloud deploy` writes this for you):
# COMPOSE_FILE=compose.yaml:compose.cloud.yaml

# Google Cloud DNS record for ./mc dns (optional).
DNS_NAME=mc.example.com
DNS_ZONE=example-com
DNS_PROJECT=my-gcp-project
